<!doctype html>
<html lang="en" data-theme="brand"<% if (brand.style) { %> style="<%= brand.style %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#0e0e0e">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %><%= brand.name %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="/static/css/app.css?v=<%= typeof assetV !== 'undefined' ? assetV : '' %>">
<% if (brand.logoUrl) { %>
  <link rel="icon" href="<%= brand.logoUrl %>">
  <% } else { const fav = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='${brand.color}'/><text x='16' y='22' font-family='Arial Black,Arial' font-weight='900' font-size='${brand.mark.length > 2 ? 10 : 14}' text-anchor='middle' fill='${brand.contentColor}'>${brand.mark}</text></svg>`; %>
  <link rel="icon" href="data:image/svg+xml,<%= encodeURIComponent(fav) %>">
  <% } %>
  <script src="/static/js/app.js?v=<%= typeof assetV !== 'undefined' ? assetV : '' %>" defer></script>
</head>
