<%- include('partials/header', { title: 'Dashboard' }) %>
<% const nowIso = new Date().toISOString(); %>
<div class="mb-4">
  <p class="text-sm text-base-content/60"><%= user.role === 'sales' ? 'My leads' : user.role === 'manager' ? 'My team' : 'All of GKF' %></p>
  <h1 class="page-title max-lg:hidden">Dashboard</h1>
</div>

<div class="mb-4 grid grid-cols-2 gap-3 lg:grid-cols-6">
  <% const kpis = [
       ['/leads?needs_human=1', 'Needs human', d.needsHuman, d.needsHuman ? 'text-primary' : ''],
       ['/leads?status=hot', 'Hot leads', d.counts.hot, ''],
       ['/followups', 'Overdue follow-ups', d.overdue, d.overdue ? 'text-error' : ''],
       ['/leads?sort=created', 'New this week', d.newThisWeek, ''],
       ['/leads?status=converted', 'Converted', d.counts.converted, 'text-success']
     ];
     if (user.role !== 'sales') kpis.splice(3, 0, ['/leads?assignee=unassigned', 'Unassigned', d.unassigned, '']); %>
  <% for (const [href, label, value, cls] of kpis) { %>
    <a href="<%= href %>" class="rounded-box bg-base-100 p-4 transition hover:bg-base-300">
      <div class="text-xs text-base-content/60"><%= label %></div>
      <div class="mt-1 text-3xl font-bold tabular-nums <%= cls %>"><%= value %></div>
    </a>
  <% } %>
</div>

<div class="grid gap-4 lg:grid-cols-2">
  <section>
    <div class="mb-2 flex items-center justify-between"><h2>Waiting on a human</h2><a href="/leads?needs_human=1" class="link link-hover text-sm text-primary">See all</a></div>
    <%- include('partials/lead-table', { leads: d.attention, emptyText: 'Nobody is waiting. The bot has it covered.' }) %>
  </section>
  <section>
    <div class="mb-2 flex items-center justify-between"><h2>My follow-ups</h2><a href="/followups" class="link link-hover text-sm text-primary">See all</a></div>
    <% if (!d.myFollowUps.length) { %><p class="rounded-box bg-base-100 py-8 text-center text-sm text-base-content/60">No open follow-ups.</p><% } else { %>
    <ul class="list rounded-box bg-base-100">
      <% for (const f of d.myFollowUps) { const late = f.due_at < nowIso; const today = !late && f.due_at.slice(0, 10) === nowIso.slice(0, 10); %>
      <li class="list-row items-center">
        <span class="status <%= late ? 'status-error' : today ? 'status-warning' : 'status-success' %>"></span>
        <div class="min-w-0">
          <div class="truncate text-sm font-medium"><%= f.title %></div>
          <div class="text-xs text-base-content/60"><a class="link link-hover" href="/leads/<%= f.wa_id %>"><%= util.leadTitle(f) %></a> · <span class="<%= late ? 'text-error' : '' %>">Due <%= util.fmtDate(f.due_at) %></span></div>
        </div>
        <form method="post" action="/followups/<%= f.id %>/done"><%- include('partials/csrf') %><button class="btn btn-ghost btn-sm">Done</button></form>
      </li>
      <% } %>
    </ul><% } %>
  </section>
</div>

<section class="mt-4">
  <h2 class="mb-2">Latest WhatsApp activity</h2>
  <%- include('partials/lead-table', { leads: d.recent, emptyText: user.role === 'sales' ? 'No leads are assigned to you yet.' : 'No leads yet.' }) %>
</section>
<%- include('partials/footer') %>
