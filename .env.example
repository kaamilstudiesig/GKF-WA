# Copy to .env for local development. On Heroku, set these as Config Vars instead.

PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Postgres, shared by the bot and the CRM. Heroku sets this automatically when you add Heroku Postgres.
# Leave empty locally to use a built-in PGlite database stored in ./data/pglite.
DATABASE_URL=
# Max connections for the whole app, bot and CRM together (Essential-0 allows 20)
# DATABASE_POOL_MAX=5

# Meta WhatsApp Cloud API (Meta app dashboard > WhatsApp > API setup)
# Leave META_ACCESS_TOKEN empty locally and replies are simulated instead of sent.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0

# OpenRouter. Leave the key empty locally to use simple offline replies.
OPENROUTER_API_KEY=
# Picked from a 16-model test on real GKF lead scenarios (Oct 2026): DeepSeek V4.1 Flash
# passed all checks at about $0.43 per 1,000 replies; Gemini 3.5 Flash Lite (a different
# provider) is the backup. Avoid gemini-2.5-flash-lite, gpt-5-nano and z-ai/glm-5.3-flash.
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_FALLBACK_MODEL=google/gemini-3.5-flash-lite

# Monthly AI guardrails; when reached, leads are handed to staff instead.
AI_MONTHLY_TOKEN_BUDGET=5000000
AI_MONTHLY_REQUEST_BUDGET=20000
# Earlier chat messages the AI sees with each reply (more = better context, higher cost)
AI_HISTORY_MESSAGES=10
# Most bot replies one lead gets per 24h; then the lead goes to staff and the bot stops answering them.
MAX_BOT_REPLIES_PER_LEAD_PER_DAY=30
# Bot stays quiet for this many hours after staff reply from the CRM.
BOT_PAUSE_HOURS_AFTER_STAFF_REPLY=12
# Gym map pin sent with the location answer (leave empty to send the address only).
GYM_LATITUDE=
GYM_LONGITUDE=

# Staff alerts and daily backups via Telegram (free). Create a bot with @BotFather,
# add it to a private staff group, and put the group's chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: separate Telegram group for technical alerts (failed sends, account warnings). Defaults to TELEGRAM_CHAT_ID.
TELEGRAM_OPS_CHAT_ID=
# Minutes before the same technical alert repeats (default 30).
OPS_ALERT_COOLDOWN_MINUTES=30
# CRM address used in "Open in CRM" links
CRM_BASE_URL=https://crm.goldkraftfitness.com

# --- Staff CRM (served by this same app) ---
# Hostnames that get the CRM instead of the bot (comma list, no port). Locally,
# open http://crm.localhost:3000 for the CRM and http://localhost:3000 for the bot.
CRM_HOSTS=crm.goldkraftfitness.com,crm.localhost
# Hours a CRM login stays valid
SESSION_TTL_HOURS=12
# Timezone for CRM dates, and rough rate for showing AI cost in rupees
DISPLAY_TIMEZONE=Asia/Kolkata
USD_TO_INR=85
# Starting staff accounts for `npm run crm:seed` (passwords must be changed at first login)
SEED_USERS_FILE=./crm/seed/users.example.json

# Optional error tracking
SENTRY_DSN=
