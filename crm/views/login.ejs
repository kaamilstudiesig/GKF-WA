<%- include('partials/head', { title: 'Sign in' }) %>
<body>
<div class="auth-wrap">
  <div class="card auth-card">
    <%- include('partials/brand') %>
    <h1>Staff Sign In</h1>
    <p class="muted small" style="text-align:center;margin-top:-4px">WhatsApp leads, follow-ups and reports for the GKF team.</p>
    <% if (error) { %><div class="alert alert-err" role="alert"><%= error %></div><% } %>
    <form method="post" action="/login">
      <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="username" required value="<%= email %>" autofocus></div>
      <div class="field"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required></div>
      <button class="btn" type="submit">Sign in</button>
    </form>
  </div>
</div>
</body>
</html>
