<%- include('partials/header', { title: 'Change password' }) %>
<div class="page-head"><div><div class="eyebrow">Account</div><h1>Change Password</h1></div></div>
<div class="card" style="max-width:480px">
  <% if (first) { %><div class="alert alert-gold">You're using a temporary password. Set your own before continuing.</div><% } %>
  <form method="post" action="/account/password">
    <%- include('partials/csrf') %>
    <div class="field"><label for="cur">Current password</label><input id="cur" name="current_password" type="password" autocomplete="current-password" required></div>
    <div class="field"><label for="new">New password</label><input id="new" name="new_password" type="password" autocomplete="new-password" minlength="10" required>
      <div class="muted small" style="margin-top:4px">At least 10 characters, with letters and numbers.</div></div>
    <div class="field"><label for="conf">Confirm new password</label><input id="conf" name="confirm_password" type="password" autocomplete="new-password" minlength="10" required></div>
    <button class="btn" type="submit">Update password</button>
  </form>
</div>
<%- include('partials/footer') %>
