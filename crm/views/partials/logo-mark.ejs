<%# Square logo: the uploaded image, else the logo letters on the brand colour (R12). On the shared CRM: the Dartit mark (min 24 px). -%>
<% if (brand.platform) { %><picture class="<%= size %> shrink-0"><source srcset="/static/brand/dartit/dartit-mark-dark.svg" media="(prefers-color-scheme: dark)"><img src="/static/brand/dartit/dartit-mark-light.svg" alt="Dartit" class="<%= size %> object-contain"></picture><% } else if (brand.logoUrl) { %><img src="<%= brand.logoUrl %>" alt="" class="<%= size %> shrink-0 rounded-lg object-contain"><% } else { %><span class="grid <%= size %> shrink-0 place-items-center rounded-lg bg-primary font-display text-xl text-primary-content"><%= brand.mark %></span><% } %>
