<%- include('partials/header', { title: util.leadTitle(lead), back: '/leads' }) %>
<%
  const phone = util.leadPhone(lead);
  const last = outcomes[0];
  const nowIso = new Date().toISOString();
  const initials = (lead.display_name || '#').split(' ').map(s => s[0]).join('').slice(0, 2).toUpperCase();
  const quick = [['called_connected', 'phone'], ['no_answer', 'phone-off'], ['whatsapp_sent', 'message'], ['visited', 'pin'], ['no_show', 'calendar-x']];
  const card = 'rounded-box bg-base-100 p-4';
%>

<%# ---------- Header: who, status, quick actions ---------- %>
<section class="<%= card %> mb-4">
  <div class="flex items-start gap-3">
    <div class="avatar avatar-placeholder"><div class="w-12 rounded-full <%= lead.needs_human ? 'bg-primary text-primary-content' : 'bg-neutral text-neutral-content' %>"><span class="font-semibold"><%= initials %></span></div></div>
    <div class="min-w-0 flex-1">
      <h1 class="truncate text-xl font-bold lg:font-display lg:text-4xl lg:font-normal lg:tracking-wide"><%= util.leadTitle(lead) %></h1>
      <div class="text-sm text-base-content/60"><%= util.contactLabel(lead) %><% if (lead.ad) { %> · from <span class="capitalize"><%= lead.ad.platform %></span> ad<% } %></div>
      <div class="mt-2 flex flex-wrap gap-1.5">
        <%- include('partials/status', { status: lead.status }) %>
        <% if (lead.needs_human) { %><span class="badge badge-primary badge-sm">Needs human · <%= util.humanize(lead.handoff_reason) %></span><% } %>
        <span class="badge badge-sm <%= lead.window_open ? 'badge-success badge-soft' : 'badge-ghost' %>"><%= lead.window_open ? 'Reply window open' : 'Reply window closed' %></span>
      </div>
    </div>
  </div>
  <div class="mt-4 hidden flex-wrap gap-2 lg:flex">
    <a href="#outcome" class="btn btn-primary"><%- include('partials/icon', { name: 'clipboard' }) %>Log outcome</a>
    <% if (phone) { %>
      <a href="tel:+<%= phone %>" class="btn btn-outline"><%- include('partials/icon', { name: 'phone' }) %>Call</a>
      <a href="https://wa.me/<%= phone %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline"><%- include('partials/icon', { name: 'message' }) %>Open in WhatsApp</a>
    <% } %>
  </div>
  <% if (last) { %>
  <div class="mt-3 rounded-field bg-base-200 px-3 py-2 text-sm">Last outcome: <strong><%= OUTCOMES[last.outcome] %></strong><span class="text-base-content/60"> · <%= last.user_name || 'Former staff' %> · <%= util.timeAgo(last.created_at) %></span></div>
  <% } %>
</section>

<%# ---------- Tabs (phones only; desktop shows two columns) ---------- %>
<div role="tablist" class="tabs tabs-box mb-4 lg:hidden" data-tabs>
  <% for (const [key, label] of [['chat', 'Chat'], ['details', 'Details'], ['tasks', 'Tasks'], ['history', 'History']]) { %>
    <button type="button" role="tab" class="tab flex-1" data-tab="<%= key %>"><%= label %></button>
  <% } %>
</div>

<div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_23rem]">
  <div class="space-y-4">
    <%# Chat %>
    <section class="<%= card %>" data-panel="chat" aria-label="WhatsApp conversation">
      <h2 class="mb-3 hidden lg:block">Conversation</h2>
      <div class="chat-scroll -mx-1 px-1" data-chat>
        <% if (!messages.length && !queued.length) { %><p class="py-6 text-center text-sm text-base-content/60">No messages yet.</p><% } %>
        <% for (const m of messages) { const mine = m.direction !== 'in'; %>
          <div class="chat <%= mine ? 'chat-end' : 'chat-start' %>">
            <div class="chat-bubble whitespace-pre-line text-[15px] <%= mine ? 'bg-primary/15 text-base-content' : '' %>"><%= m.text %></div>
            <div class="chat-footer text-xs opacity-60"><%= mine ? 'GKF' : 'Lead' %> · <%= util.fmtDate(m.timestamp) %></div>
          </div>
        <% } %>
        <% for (const q of queued) { %>
          <div class="chat chat-end">
            <div class="chat-bubble whitespace-pre-line border border-dashed <%= q.status === 'failed' ? 'border-error' : 'border-primary/50' %> bg-transparent text-base-content"><%= q.text %></div>
            <div class="chat-footer text-xs <%= q.status === 'failed' ? 'text-error' : 'opacity-60' %>"><%= q.metadata.user_name || 'Staff' %> · <%= q.status === 'failed' ? 'Failed: ' + (q.last_error || 'unknown error') : 'Queued, waiting for the WhatsApp bot to send' %></div>
          </div>
        <% } %>
      </div>
      <form class="mt-3 border-t border-base-300 pt-3" method="post" action="/leads/<%= lead.wa_id %>/message">
        <%- include('partials/csrf') %>
        <label for="reply" class="sr-only">Reply on WhatsApp</label>
        <div class="flex items-end gap-2">
          <textarea id="reply" name="text" maxlength="4096" data-count rows="2" class="textarea flex-1 text-[15px]" <%= lead.window_open ? '' : 'disabled' %> placeholder="<%= lead.window_open ? 'Reply on WhatsApp…' : 'The 24-hour window is closed. The lead has to message GKF again first.' %>" required></textarea>
          <button class="btn btn-primary btn-square" type="submit" aria-label="Send reply" <%= lead.window_open ? '' : 'disabled' %>><%- include('partials/icon', { name: 'send' }) %></button>
        </div>
        <div class="mt-1 text-right text-xs text-base-content/50" data-counter></div>
      </form>
    </section>
  </div>

  <div class="space-y-4">
    <%# Details %>
    <section class="<%= card %>" data-panel="details">
      <h2 class="mb-3">Lead details</h2>
      <dl class="grid grid-cols-[7rem_1fr] gap-x-3 gap-y-2 text-sm">
        <dt class="text-base-content/60">Phone</dt><dd><%= util.contactLabel(lead) %><% if (!phone) { %> <span class="text-xs text-base-content/50">(WhatsApp username, number not shared)</span><% } %></dd>
        <dt class="text-base-content/60">Interest</dt><dd class="capitalize"><%= util.humanize(lead.interest) || '—' %></dd>
        <dt class="text-base-content/60">Source</dt><dd><%= util.humanize(lead.source) %></dd>
        <% if (lead.ad) { %><dt class="text-base-content/60">Ad</dt><dd><span class="capitalize"><%= lead.ad.platform %></span>: <%= lead.ad.headline || ('ad ' + (lead.ad.source_id || '')) %>
          <% if (lead.ad.source_url && /^https:\/\//.test(lead.ad.source_url)) { %> · <a class="link link-primary" href="<%= lead.ad.source_url %>" target="_blank" rel="noopener noreferrer">view</a><% } %></dd><% } %>
        <dt class="text-base-content/60">First contact</dt><dd><%= util.fmtDate(lead.first_contact_at) %></dd>
        <dt class="text-base-content/60">Last message</dt><dd><%= util.timeAgo(lead.last_inbound_message_at) %></dd>
        <dt class="text-base-content/60">Owner</dt><dd><%= lead.assignee_name || 'Unassigned' %></dd>
      </dl>
      <form method="post" action="/leads/<%= lead.wa_id %>/status" class="mt-4 flex items-end gap-2">
        <%- include('partials/csrf') %>
        <fieldset class="fieldset flex-1 py-0"><legend class="fieldset-legend">Status</legend>
          <select id="st" name="status" class="select w-full capitalize"><% for (const s of LEAD_STATUSES) { %><option value="<%= s %>" <%= s === lead.status ? 'selected' : '' %>><%= s %></option><% } %></select></fieldset>
        <button class="btn" type="submit">Update</button>
      </form>
      <% if (can.assignLeads(user)) { %>
      <form method="post" action="/leads/<%= lead.wa_id %>/assign" class="mt-2 flex items-end gap-2">
        <%- include('partials/csrf') %>
        <fieldset class="fieldset flex-1 py-0"><legend class="fieldset-legend">Assign to</legend>
          <select id="as" name="user_id" class="select w-full"><option value="">Unassigned</option>
            <% for (const s of staff) { %><option value="<%= s.id %>" <%= s.id === lead.assignee_id ? 'selected' : '' %>><%= s.name %> (<%= ROLE_LABELS[s.role] %>)</option><% } %>
          </select></fieldset>
        <button class="btn" type="submit">Assign</button>
      </form>
      <% } %>
      <% if (lead.needs_human) { %>
      <form method="post" action="/leads/<%= lead.wa_id %>/handoff/resolve" class="mt-3">
        <%- include('partials/csrf') %>
        <button class="btn btn-ghost btn-sm w-full" type="submit">Mark hand-off resolved</button>
      </form>
      <% } %>
    </section>

    <%# Tasks: follow-ups + notes %>
    <section class="<%= card %>" data-panel="tasks">
      <h2 class="mb-3">Follow-ups</h2>
      <ul class="space-y-2">
        <% for (const f of followUps) { const late = f.status === 'open' && f.due_at < nowIso; const today = f.status === 'open' && !late && f.due_at.slice(0, 10) === nowIso.slice(0, 10); %>
        <li class="flex items-center gap-3 rounded-field bg-base-200 px-3 py-2">
          <span class="status <%= f.status === 'done' ? 'status-neutral' : late ? 'status-error' : today ? 'status-warning' : 'status-success' %>"></span>
          <div class="min-w-0 flex-1">
            <div class="truncate text-sm <%= f.status === 'done' ? 'line-through opacity-50' : '' %>"><%= f.title %></div>
            <div class="text-xs text-base-content/60"><%= f.user_name %> · <span class="<%= late ? 'text-error' : '' %>"><%= f.status === 'done' ? 'Done ' + util.fmtDate(f.completed_at) : 'Due ' + util.fmtDate(f.due_at) %></span></div>
          </div>
          <% if (f.status === 'open') { %><form method="post" action="/followups/<%= f.id %>/done"><%- include('partials/csrf') %><button class="btn btn-ghost btn-sm">Done</button></form><% } %>
        </li>
        <% } %>
        <% if (!followUps.length) { %><li class="text-sm text-base-content/60">Nothing scheduled.</li><% } %>
      </ul>
      <details class="collapse collapse-plus mt-3 bg-base-200">
        <summary class="collapse-title text-sm font-medium">Schedule a follow-up</summary>
        <form class="collapse-content space-y-2" method="post" action="/leads/<%= lead.wa_id %>/followups">
          <%- include('partials/csrf') %>
          <fieldset class="fieldset py-0"><legend class="fieldset-legend">What</legend><input id="fu" name="title" maxlength="200" required placeholder="Call to confirm trial" class="input w-full"></fieldset>
          <fieldset class="fieldset py-0"><legend class="fieldset-legend">Due</legend><input id="due" name="due_at" type="datetime-local" required class="input w-full"></fieldset>
          <% if (staff.length) { %><fieldset class="fieldset py-0"><legend class="fieldset-legend">For</legend>
            <select id="fuw" name="user_id" class="select w-full"><option value="">Lead owner</option><% for (const s of staff) { %><option value="<%= s.id %>"><%= s.name %></option><% } %></select></fieldset><% } %>
          <button class="btn btn-primary btn-sm w-full" type="submit">Schedule</button>
        </form>
      </details>

      <h2 class="mt-6 mb-3">Notes</h2>
      <form method="post" action="/leads/<%= lead.wa_id %>/notes" class="space-y-2">
        <%- include('partials/csrf') %>
        <label for="note" class="sr-only">Add a note</label>
        <textarea id="note" name="body" rows="2" maxlength="5000" required placeholder="Preferences, objections, anything useful…" class="textarea w-full"></textarea>
        <button class="btn btn-sm" type="submit">Save note</button>
      </form>
      <ul class="mt-3 space-y-3">
        <% for (const n of notes) { %><li class="text-sm"><div class="whitespace-pre-line"><%= n.body %></div><div class="text-xs text-base-content/50"><%= n.user_name || 'Former staff' %> · <%= util.fmtDate(n.created_at) %></div></li><% } %>
        <% if (lead.notes) { %><li class="text-sm"><div class="whitespace-pre-line text-base-content/70"><%= lead.notes %></div><div class="text-xs text-base-content/50">From the WhatsApp bot</div></li><% } %>
        <% if (!notes.length && !lead.notes) { %><li class="text-sm text-base-content/60">No notes yet.</li><% } %>
      </ul>
    </section>

    <%# History: outcomes, bot hand-offs, activity %>
    <section class="<%= card %>" data-panel="history">
      <h2 class="mb-3">History</h2>
      <% if (!outcomes.length && !handoffs.length && !activity.length) { %><p class="text-sm text-base-content/60">Nothing yet.</p><% } %>
      <% if (outcomes.length) { %>
      <ul class="mb-4 space-y-2">
        <% for (const o of outcomes.slice(0, 10)) { %>
        <li class="rounded-field bg-base-200 px-3 py-2 text-sm"><strong><%= OUTCOMES[o.outcome] %></strong>
          <% if (o.outcome === 'joined') { %> · <%= o.plan %> · ₹<%= Number(o.amount_inr).toLocaleString('en-IN') %><% } %>
          <% if (o.outcome === 'visit_booked' && o.visit_at) { %> · for <%= util.fmtDate(o.visit_at) %><% } %>
          <% if (o.outcome === 'lost') { %> · <%= LOST_REASONS[o.lost_reason] || o.lost_reason %><% } %>
          <div class="text-xs text-base-content/50"><%= o.user_name || 'Former staff' %> · <%= util.fmtDate(o.created_at) %><% if (o.note) { %> · <%= o.note %><% } %></div></li>
        <% } %>
      </ul>
      <% } %>
      <% if (handoffs.length) { %>
      <h3 class="mb-2 text-sm font-semibold text-base-content/70">Bot hand-offs</h3>
      <ul class="mb-4 space-y-2 text-sm">
        <% for (const hf of handoffs) { %><li><span class="capitalize"><%= util.humanize(hf.reason) %></span> <span class="badge badge-ghost badge-xs"><%= hf.status %></span><% if (hf.summary) { %><div class="text-base-content/70"><%= hf.summary %></div><% } %><div class="text-xs text-base-content/50"><%= util.fmtDate(hf.created_at) %></div></li><% } %>
      </ul>
      <% } %>
      <% if (activity.length) { %>
      <h3 class="mb-2 text-sm font-semibold text-base-content/70">Activity</h3>
      <ul class="space-y-1.5 text-xs text-base-content/60">
        <% for (const a of activity) { %><li><span class="text-base-content/80"><%= a.user_name || 'System' %></span> · <%= util.humanize(a.action) %><% if (a.details && a.details.to) { %> → <%= a.details.to %><% } %><% if (a.details && a.details.outcome) { %>: <%= OUTCOMES[a.details.outcome] || a.details.outcome %><% } %> · <%= util.timeAgo(a.created_at) %></li><% } %>
      </ul>
      <% } %>
    </section>
  </div>
</div>

<%# ---------- Log outcome bottom sheet (opens on #outcome, also from Telegram's button) ---------- %>
<div class="modal modal-bottom sm:modal-middle" id="outcome" role="dialog" aria-modal="true" aria-labelledby="outcome-h">
  <div class="modal-box pb-[calc(1.25rem+env(safe-area-inset-bottom))]">
    <div class="mb-4 flex items-center justify-between">
      <h2 id="outcome-h" class="text-lg font-semibold">Log outcome</h2>
      <a href="#" class="btn btn-ghost btn-sm btn-circle" aria-label="Close"><%- include('partials/icon', { name: 'x' }) %></a>
    </div>
    <form method="post" action="/leads/<%= lead.wa_id %>/outcome" class="grid grid-cols-2 gap-2">
      <%- include('partials/csrf') %>
      <% for (const [o, icon] of quick) { %>
        <button class="btn h-auto min-h-16 flex-col gap-1 border-base-300 bg-base-200 py-3 text-sm font-medium" type="submit" name="outcome" value="<%= o %>"><%- include('partials/icon', { name: icon }) %><%= OUTCOMES[o] %></button>
      <% } %>
    </form>
    <div class="mt-3 space-y-2">
      <details class="collapse collapse-arrow bg-base-200">
        <summary class="collapse-title flex items-center gap-2 text-sm font-medium"><%- include('partials/icon', { name: 'calendar-plus' }) %>Visit booked…</summary>
        <form method="post" action="/leads/<%= lead.wa_id %>/outcome" class="collapse-content space-y-2">
          <%- include('partials/csrf') %>
          <input type="hidden" name="outcome" value="visit_booked">
          <fieldset class="fieldset py-0"><legend class="fieldset-legend">Visit date and time</legend><input id="visit_at" name="visit_at" type="datetime-local" required class="input w-full"></fieldset>
          <button class="btn btn-primary w-full" type="submit">Save visit</button>
        </form>
      </details>
      <details class="collapse collapse-arrow bg-base-200">
        <summary class="collapse-title flex items-center gap-2 text-sm font-medium text-primary"><%- include('partials/icon', { name: 'rupee' }) %>Joined…</summary>
        <form method="post" action="/leads/<%= lead.wa_id %>/outcome" class="collapse-content space-y-2">
          <%- include('partials/csrf') %>
          <input type="hidden" name="outcome" value="joined">
          <fieldset class="fieldset py-0"><legend class="fieldset-legend">Plan</legend>
            <input id="plan" name="plan" list="plan-options" maxlength="100" required placeholder="Quarterly Elite" class="input w-full">
            <datalist id="plan-options"><% for (const p of PLAN_OPTIONS) { %><option value="<%= p %>"><% } %></datalist></fieldset>
          <fieldset class="fieldset py-0"><legend class="fieldset-legend">Amount paid (₹)</legend><input id="amount" name="amount" inputmode="numeric" pattern="[0-9,₹ ]+" required placeholder="7080" class="input w-full"></fieldset>
          <button class="btn btn-primary w-full" type="submit">Save joined</button>
        </form>
      </details>
      <details class="collapse collapse-arrow bg-base-200">
        <summary class="collapse-title flex items-center gap-2 text-sm font-medium"><%- include('partials/icon', { name: 'thumbs-down' }) %>Lost…</summary>
        <form method="post" action="/leads/<%= lead.wa_id %>/outcome" class="collapse-content space-y-2">
          <%- include('partials/csrf') %>
          <input type="hidden" name="outcome" value="lost">
          <fieldset class="fieldset py-0"><legend class="fieldset-legend">Why?</legend>
            <select id="lost_reason" name="lost_reason" required class="select w-full"><option value="">Pick a reason</option>
              <% for (const [k, label] of Object.entries(LOST_REASONS)) { %><option value="<%= k %>"><%= label %></option><% } %>
            </select></fieldset>
          <fieldset class="fieldset py-0"><legend class="fieldset-legend">Note (optional)</legend><input id="lost_note" name="note" maxlength="500" class="input w-full"></fieldset>
          <button class="btn btn-primary w-full" type="submit">Save lost</button>
        </form>
      </details>
    </div>
  </div>
  <a href="#" class="modal-backdrop" aria-label="Close">Close</a>
</div>

<%# ---------- Phone action bar (replaces the dock on this screen) ---------- %>
<div class="fixed inset-x-0 bottom-0 z-30 flex gap-2 border-t border-base-300 bg-base-100 px-3 pt-2 pb-[calc(0.5rem+env(safe-area-inset-bottom))] lg:hidden">
  <% if (phone) { %>
    <a href="tel:+<%= phone %>" class="btn btn-outline btn-square btn-lg" aria-label="Call"><%- include('partials/icon', { name: 'phone' }) %></a>
    <a href="https://wa.me/<%= phone %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-square btn-lg" aria-label="Open in WhatsApp"><%- include('partials/icon', { name: 'message' }) %></a>
  <% } %>
  <a href="#outcome" class="btn btn-primary btn-lg flex-1"><%- include('partials/icon', { name: 'clipboard' }) %>Log outcome</a>
</div>
<%- include('partials/footer', { hideDock: true }) %>
