<%- include('partials/header', { title: 'Reports' }) %>
<%
  const card = 'rounded-box bg-base-100 p-4';
  const bar = (label, value, max) => ({ label, value, pct: max ? (value / max * 100).toFixed(1) : 0 });
  const inr = v => '₹' + Number(v || 0).toLocaleString('en-IN');
  const pctText = v => (v === null || v === undefined ? '—' : v + '%');
  const minText = v => (v === null || v === undefined ? '—' : v < 60 ? v + ' min' : (v / 60).toFixed(1) + ' h');
%>
<div class="mb-4 flex flex-wrap items-end justify-between gap-3">
  <div><p class="text-sm text-base-content/60"><%= user.role === 'owner' ? 'All of ' + brand.name : 'My team and unassigned leads' %></p><h1 class="page-title max-lg:hidden">Reports</h1></div>
  <div class="flex items-center gap-2">
    <div role="tablist" class="tabs tabs-box tabs-sm">
      <% for (const d of [7, 30, 90]) { %><a role="tab" href="/reports?days=<%= d %>" class="tab <%= r.days === d ? 'tab-active' : '' %>"><%= d %>d</a><% } %>
    </div>
    <a class="btn btn-ghost btn-sm" href="/reports/leads.csv"><%- include('partials/icon', { name: 'download', cls: 'size-4' }) %>CSV</a>
  </div>
</div>

<div class="mb-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
  <% for (const [label, value, hint, cls] of [['Total leads', r.counts.total, '', ''], ['Hot', r.counts.hot, '', 'text-warning'], ['Converted', r.counts.converted, '', 'text-success'], ['Win rate', r.conversionRate === null ? '—' : r.conversionRate + '%', 'converted ÷ (converted + lost)', 'text-primary']]) { %>
  <div class="<%= card %>"><div class="text-xs text-base-content/60"><%= label %></div><div class="mt-1 text-3xl font-bold tabular-nums <%= cls %>"><%= value %></div><% if (hint) { %><div class="text-[11px] text-base-content/50"><%= hint %></div><% } %></div>
  <% } %>
</div>

<h2 class="mb-2 mt-6 text-sm font-semibold text-base-content/60">Sales follow-up, last <%= a.days %> days</h2>
<div class="mb-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
  <div class="<%= card %>"><div class="text-xs text-base-content/60">Speed to lead</div>
    <div class="mt-1 text-3xl font-bold tabular-nums <%= a.speedToLead.medianMinutes !== null && a.speedToLead.medianMinutes <= 5 ? 'text-success' : a.speedToLead.medianMinutes !== null ? 'text-warning' : '' %>"><%= minText(a.speedToLead.medianMinutes) %></div>
    <div class="text-[11px] text-base-content/50">median working minutes, hand-off to first contact · <%= pctText(a.speedToLead.withinFiveMinutes) %> within 5 min</div></div>
  <div class="<%= card %>"><div class="text-xs text-base-content/60">Logging rate</div>
    <div class="mt-1 text-3xl font-bold tabular-nums <%= a.logging.rate === null ? '' : a.logging.rate >= 80 ? 'text-success' : 'text-warning' %>"><%= pctText(a.logging.rate) %></div>
    <div class="text-[11px] text-base-content/50">hand-offs with an outcome within 24 h (<%= a.logging.loggedWithin24h %> of <%= a.logging.handoffs %>)</div></div>
  <div class="<%= card %>"><div class="text-xs text-base-content/60">Not contacted yet</div>
    <div class="mt-1 text-3xl font-bold tabular-nums <%= a.speedToLead.notContacted ? 'text-error' : '' %>"><%= a.speedToLead.notContacted %></div>
    <div class="text-[11px] text-base-content/50">of <%= a.speedToLead.handoffs %> hand-offs</div></div>
  <div class="<%= card %>"><div class="text-xs text-base-content/60">Revenue</div>
    <div class="mt-1 text-3xl font-bold tabular-nums text-primary"><%= inr(a.logging.revenueInr) %></div>
    <div class="text-[11px] text-base-content/50"><%= a.logging.salesRecorded %> sales logged in these <%= a.days %> days<% if (a.logging.salesRecorded) { %> · <%= pctText(a.logging.autoRate) %> by payment link<% } %></div></div>
</div>

<div class="mb-4 grid gap-4 lg:grid-cols-2">
  <section class="<%= card %>">
    <h2 class="mb-1">Funnel</h2>
    <p class="mb-3 text-xs text-base-content/50">Leads who first messaged in the last <%= a.days %> days, by the furthest step they reached.</p>
    <% if (!a.funnel.leads) { %><p class="text-sm text-base-content/60">No new leads in this period.</p><% } else { %>
    <div class="space-y-2">
      <% for (const s of a.funnel.stages) { %>
      <div class="grid grid-cols-[7.5rem_1fr_4.5rem] items-center gap-2 text-sm">
        <span class="truncate text-base-content/70"><%= s.label %></span>
        <progress class="progress progress-primary" value="<%= s.ofLeads || 0 %>" max="100" aria-label="<%= s.label %>: <%= s.count %>"></progress>
        <span class="text-right tabular-nums"><%= s.count %><% if (s.fromPrevious !== null) { %> <span class="text-xs text-base-content/50"><%= s.fromPrevious %>%</span><% } %></span>
      </div>
      <% } %>
    </div>
    <p class="mt-2 text-xs text-base-content/50">Small % = share of the step before. Won: <%= pctText(a.funnel.winRate) %> of leads.</p>
    <% } %>
  </section>
  <section class="<%= card %>">
    <h2 class="mb-3">Why leads were lost (<%= a.days %>d)</h2>
    <% if (!a.lostReasons.length) { %><p class="text-sm text-base-content/60">No leads marked lost in this period.</p><% } else { const maxL = Math.max(...a.lostReasons.map(x => x.count)); %>
    <div class="space-y-2"><% for (const x of a.lostReasons) { const b = bar(x.label, x.count, maxL); %>
      <div class="grid grid-cols-[8.5rem_1fr_4.5rem] items-center gap-2 text-sm"><span class="truncate text-base-content/70"><%= x.label %></span><progress class="progress progress-error" value="<%= b.pct %>" max="100"></progress><span class="text-right tabular-nums"><%= x.count %> <span class="text-xs text-base-content/50"><%= x.share %>%</span></span></div>
    <% } %></div><% } %>
  </section>
</div>

<section class="<%= card %> mb-4">
  <h2 class="mb-3">Sales team (<%= a.days %>d)</h2>
  <% if (!a.people.length) { %><p class="text-sm text-base-content/60">No staff to show.</p><% } else { %>
  <div class="overflow-x-auto"><table class="table table-sm">
    <thead><tr><th>Name</th><th class="text-right">First contacts</th><th class="text-right">Median time</th><th class="text-right">Logging rate</th><th class="text-right">Outcomes</th><th class="text-right"><%= OUTCOMES.joined %></th><th class="text-right">₹</th><th class="text-right">Lost</th></tr></thead>
    <tbody><% for (const p of a.people) { %>
      <tr><td><div class="font-medium"><%= p.name %></div><div class="text-xs text-base-content/50"><%= ROLE_LABELS[p.role] %></div></td>
        <td class="text-right"><%= p.firstContacts %></td>
        <td class="text-right <%= p.medianMinutes !== null && p.medianMinutes > 5 ? 'text-warning' : '' %>"><%= minText(p.medianMinutes) %></td>
        <td class="text-right <%= p.loggingRate !== null && p.loggingRate < 80 ? 'text-warning' : '' %>"><%= pctText(p.loggingRate) %></td>
        <td class="text-right"><%= p.outcomes %></td><td class="text-right"><%= p.won %></td><td class="text-right"><%= inr(p.revenueInr) %></td><td class="text-right"><%= p.lost %></td></tr>
    <% } %></tbody>
  </table></div>
  <p class="mt-2 text-xs text-base-content/50">First contact: the first CRM reply or logged outcome after a hand-off. Logging rate: hand-offs on their leads with an outcome within 24 h.</p><% } %>
</section>

<section class="<%= card %> mb-4" id="ads">
  <% const hasSpend = adRows.some(x => x.spend !== null); const adOnly = adRows.filter(x => x.kind !== 'none'); %>
  <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
    <h2>By ad (<%= a.days %>d)</h2>
    <% if (adRows.length) { %><div class="flex items-center gap-2">
      <div class="join" role="group" aria-label="Sort ads">
        <% for (const [key, label] of [['revenue', 'Revenue'], ['leads', 'Leads']]) { %><a class="btn join-item btn-xs <%= adSort === key ? 'btn-primary' : '' %>" href="/reports?days=<%= a.days %>&adsort=<%= key %>#ads" <%= adSort === key ? 'aria-current=true' : '' %>><%= label %></a><% } %>
      </div>
      <a class="btn btn-ghost btn-xs" href="/reports/ads.csv?days=<%= a.days %>"><%- include('partials/icon', { name: 'download', cls: 'size-3.5' }) %>CSV</a>
    </div><% } %>
  </div>
  <p class="mb-3 text-xs text-base-content/50">Leads who first messaged in the last <%= a.days %> days, by the Click-to-WhatsApp ad they came from, and what they paid so far.</p>
  <% if (!adOnly.length) { %><p class="text-sm text-base-content/60">No leads from Instagram or Facebook ads in this period. They appear here once people message from a Click-to-WhatsApp ad.</p><% } %>
  <% if (adRows.length) { %>
  <div class="overflow-x-auto"><table class="table table-sm">
    <thead><tr><th>Ad</th><th class="text-right">Leads</th><th class="text-right">Qualified</th><th class="text-right"><%= OUTCOMES.visit_booked %></th><th class="text-right"><%= OUTCOMES.joined %></th><th class="text-right">Revenue</th><th class="text-right">Win rate</th><th class="text-right">Speed</th><% if (hasSpend) { %><th class="text-right">Spend</th><th class="text-right">Per sale</th><th class="text-right">ROAS</th><% } %></tr></thead>
    <tbody><% for (const x of adRows) { %>
      <tr class="<%= x.kind === 'ad' ? '' : 'text-base-content/60' %>">
        <td class="min-w-48"><% if (x.kind === 'ad') { %>
          <div class="flex items-center gap-1.5"><span class="badge badge-ghost badge-xs capitalize"><%= x.platform || 'meta' %></span><% if (x.grade) { %><span class="badge badge-xs <%= { A: 'badge-success', B: 'badge-info', C: 'badge-warning', D: 'badge-error' }[x.grade] %> badge-soft" title="Lead quality: share of leads that reached Qualified">Grade <%= x.grade %></span><% } %></div>
          <div class="mt-0.5 line-clamp-2"><%= x.headline || ('Ad ' + x.adId) %></div>
          <% if (x.campaignName) { %><div class="text-[11px] text-base-content/50"><%= x.campaignName %></div><% } %>
        <% } else if (x.kind === 'missing') { %><span title="These leads came from an ad, but Meta didn't send which one">Ad (id missing)</span><% } else { %>Not from an ad<% } %></td>
        <td class="text-right tabular-nums"><%= x.leads %></td>
        <td class="text-right tabular-nums"><%= x.qualified %> <span class="text-[11px] text-base-content/50"><%= pctText(x.qualifiedRate) %></span></td>
        <td class="text-right tabular-nums"><%= x.visitBooked %></td>
        <td class="text-right tabular-nums"><%= x.won %></td>
        <td class="text-right tabular-nums <%= x.revenueInr ? 'font-semibold text-success' : '' %>"><%= inr(x.revenueInr) %></td>
        <td class="text-right tabular-nums"><%= pctText(x.winRate) %></td>
        <td class="text-right tabular-nums"><%= minText(x.medianMinutes) %></td>
        <% if (hasSpend) { %><td class="text-right tabular-nums"><%= x.spend === null ? '—' : inr(x.spend) %></td><td class="text-right tabular-nums"><%= x.costPerSale === null ? '—' : inr(x.costPerSale) %></td><td class="text-right tabular-nums"><%= x.roas === null ? '—' : x.roas + '×' %></td><% } %>
      </tr>
    <% } %></tbody>
  </table></div>
  <p class="mt-2 text-xs text-base-content/50">Revenue: what these leads paid so far, whenever they paid. Speed: median working minutes from hand-off to first contact. Grade (from <%= GRADE_MIN_LEADS %> leads): A at least 50% qualified, B 30%, C 15%, D below. "Ad (id missing)": leads from an ad Meta didn't name.<% if (!hasSpend) { %> Spend, cost per sale, ROAS and campaigns appear once ad spend is imported from Meta.<% } %></p>
  <% } %>
  <% if (a.campaigns.length) { %>
  <h3 class="mt-4 mb-2 text-sm font-semibold">By campaign</h3>
  <div class="overflow-x-auto"><table class="table table-sm">
    <thead><tr><th>Campaign</th><th class="text-right">Ads</th><th class="text-right">Leads</th><th class="text-right">Qualified</th><th class="text-right"><%= OUTCOMES.joined %></th><th class="text-right">Revenue</th><th class="text-right">Spend</th><th class="text-right">Per sale</th><th class="text-right">ROAS</th></tr></thead>
    <tbody><% for (const c of a.campaigns) { %>
      <tr><td class="min-w-40"><%= c.campaignName || ('Campaign ' + c.campaignId) %></td><td class="text-right tabular-nums"><%= c.ads %></td><td class="text-right tabular-nums"><%= c.leads %></td>
        <td class="text-right tabular-nums"><%= c.qualified %> <span class="text-[11px] text-base-content/50"><%= pctText(c.qualifiedRate) %></span></td><td class="text-right tabular-nums"><%= c.won %></td>
        <td class="text-right tabular-nums <%= c.revenueInr ? 'font-semibold text-success' : '' %>"><%= inr(c.revenueInr) %></td>
        <td class="text-right tabular-nums"><%= c.spend === null ? '—' : inr(c.spend) %></td><td class="text-right tabular-nums"><%= c.costPerSale === null ? '—' : inr(c.costPerSale) %></td><td class="text-right tabular-nums"><%= c.roas === null ? '—' : c.roas + '×' %></td></tr>
    <% } %></tbody>
  </table></div>
  <% } %>
</section>

<div class="grid gap-4 lg:grid-cols-2">
  <section class="<%= card %>">
    <h2 class="mb-3">Pipeline</h2>
    <% const maxS = Math.max(1, ...LEAD_STATUSES.map(s => r.counts[s])); %>
    <div class="space-y-2">
      <% for (const s of LEAD_STATUSES) { const b = bar(s, r.counts[s], maxS); %>
      <div class="grid grid-cols-[6.5rem_1fr_2.5rem] items-center gap-2 text-sm"><span class="capitalize text-base-content/70"><%= s %></span><progress class="progress progress-primary" value="<%= b.pct %>" max="100"></progress><span class="text-right tabular-nums"><%= b.value %></span></div>
      <% } %>
    </div>
  </section>
  <section class="<%= card %>">
    <h2 class="mb-3">New leads per day</h2>
    <% const maxD = Math.max(1, ...r.perDay.map(p => p.c)); %>
    <div class="flex h-32 items-end gap-0.5" role="img" aria-label="New leads per day for the last <%= r.perDay.length %> days">
      <% for (const p of r.perDay) { %><div class="flex-1 rounded-t-sm <%= p.c ? 'bg-primary' : 'bg-base-300' %>" style="height:<%= Math.max(3, p.c / maxD * 100).toFixed(1) %>%" title="<%= p.day %>: <%= p.c %>"></div><% } %>
    </div>
    <div class="mt-2 flex justify-between text-xs text-base-content/50"><span><%= r.perDay[0] && r.perDay[0].day %></span><span>peak <%= maxD %>/day</span><span><%= r.perDay.length && r.perDay[r.perDay.length - 1].day %></span></div>
  </section>
  <section class="<%= card %>">
    <h2 class="mb-3">What leads ask about</h2>
    <% if (!r.interests.length) { %><p class="text-sm text-base-content/60">No data yet.</p><% } else { const maxI = Math.max(...r.interests.map(i => i.c)); %>
    <div class="space-y-2"><% for (const i of r.interests) { const b = bar(util.humanize(i.interest), i.c, maxI); %>
      <div class="grid grid-cols-[8rem_1fr_2.5rem] items-center gap-2 text-sm"><span class="truncate capitalize text-base-content/70"><%= b.label %></span><progress class="progress progress-primary" value="<%= b.pct %>" max="100"></progress><span class="text-right tabular-nums"><%= b.value %></span></div>
    <% } %></div><% } %>
  </section>
  <section class="<%= card %>">
    <h2 class="mb-3">Bot hand-offs (<%= r.days %>d)</h2>
    <% if (!r.handoffReasons.length) { %><p class="text-sm text-base-content/60">No handoffs in this period.</p><% } else { %>
    <div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Reason</th><th class="text-right">Total</th><th class="text-right">Open</th></tr></thead><tbody>
      <% for (const h of r.handoffReasons) { %><tr><td class="capitalize"><%= util.humanize(h.reason) %></td><td class="text-right"><%= h.c %></td><td class="text-right <%= h.open ? 'text-primary' : '' %>"><%= h.open %></td></tr><% } %>
    </tbody></table></div><% } %>
  </section>
  <section class="<%= card %>">
    <h2 class="mb-3">Lead sources (<%= r.days %>d)</h2>
    <% if (!r.sources.length) { %><p class="text-sm text-base-content/60">No leads in this period.</p><% } else { %>
    <div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Source</th><th class="text-right">Leads</th><th class="text-right"><%= OUTCOMES.joined %></th><th class="text-right">Rate</th></tr></thead><tbody>
      <% for (const s of r.sources) { %><tr><td class="capitalize"><%= util.humanize(s.source) %></td><td class="text-right"><%= s.c %></td><td class="text-right"><%= s.converted %></td><td class="text-right"><%= s.c ? Math.round(s.converted / s.c * 100) + '%' : '—' %></td></tr><% } %>
    </tbody></table></div><% } %>
  </section>
</div>

<section class="<%= card %> mt-4">
  <h2 class="mb-3">Workload now</h2>
  <% if (!r.reps.length) { %><p class="text-sm text-base-content/60">No staff to show.</p><% } else { %>
  <div class="overflow-x-auto"><table class="table table-sm">
    <thead><tr><th>Name</th><th class="text-right">Assigned</th><th class="text-right">Hot</th><th class="text-right">Won</th><th class="text-right">Lost</th><th class="text-right">Open tasks</th><th class="text-right">Overdue</th><th class="text-right">Actions</th></tr></thead>
    <tbody><% for (const p of r.reps) { %>
      <tr><td><div class="font-medium"><%= p.name %></div><div class="text-xs text-base-content/50"><%= ROLE_LABELS[p.role] %></div></td>
        <td class="text-right"><%= p.assigned %></td><td class="text-right"><%= p.hot %></td><td class="text-right"><%= p.converted %></td><td class="text-right"><%= p.lost %></td>
        <td class="text-right"><%= p.open_followups %></td><td class="text-right <%= p.overdue ? 'text-error' : '' %>"><%= p.overdue %></td><td class="text-right"><%= p.actions %></td></tr>
    <% } %></tbody>
  </table></div><% } %>
</section>

<% if (r.ai) { %>
<section class="<%= card %> mt-4">
  <h2 class="mb-3">WhatsApp bot AI usage (<%= r.days %>d)</h2>
  <% if (!r.ai.length) { %><p class="text-sm text-base-content/60">No AI calls in this period.</p><% } else { const totUsd = r.ai.reduce((s, a) => s + a.cost_usd, 0); %>
  <div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Model</th><th class="text-right">Requests</th><th class="text-right">Failed</th><th class="text-right">Tokens</th><th class="text-right">USD</th><th class="text-right">₹ (est.)</th></tr></thead><tbody>
    <% for (const a of r.ai) { %><tr><td class="max-w-48 truncate"><%= a.model %></td><td class="text-right"><%= a.requests %></td><td class="text-right"><%= a.failed %></td><td class="text-right"><%= a.tokens.toLocaleString('en-IN') %></td><td class="text-right">$<%= a.cost_usd.toFixed(4) %></td><td class="text-right">₹<%= a.cost_inr.toFixed(2) %></td></tr><% } %>
    <tr class="font-semibold"><td>Total</td><td></td><td></td><td></td><td class="text-right">$<%= totUsd.toFixed(4) %></td><td class="text-right">₹<%= (totUsd * r.usdToInr).toFixed(2) %></td></tr>
  </tbody></table></div>
  <p class="mt-2 text-xs text-base-content/50">₹ at ~<%= r.usdToInr %> per USD.</p><% } %>
</section>
<% } %>
<%- include('partials/footer') %>
