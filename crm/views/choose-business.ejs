<%- include('partials/head', { title: 'Choose your business' }) %>
<%# Shared CRM: this login and password work in more than one business. Each button carries a signed, 5-minute ticket. %>
<body class="grid min-h-dvh place-items-center bg-base-200 p-4">
  <main class="w-full max-w-sm rounded-box border-2 border-base-300 bg-base-100 p-6">
    <div class="mb-6"><%- include('partials/brand') %></div>
    <h1 class="text-2xl font-bold">Choose your business</h1>
    <p class="mb-4 text-sm text-base-content/60">You work with more than one business on Dartit. Pick the one to open.</p>
    <ul class="space-y-2">
      <% for (const c of choices) { %>
      <li><form method="post" action="/login/choose"><input type="hidden" name="ticket" value="<%= c.ticket %>"><button class="btn btn-outline w-full justify-start" type="submit"><%= c.name %></button></form></li>
      <% } %>
    </ul>
    <p class="mt-4 text-xs text-base-content/60">To switch later, sign out and sign in again.</p>
  </main>
</body>
</html>
