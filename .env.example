# Server Configuration
PORT=3000
NODE_ENV=development

# Meta WhatsApp Cloud API Configuration
# Get these from Meta App Dashboard & Business Settings -> System Users
META_ACCESS_TOKEN=your_permanent_system_user_access_token_here
META_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
META_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token_here
META_APP_SECRET=your_meta_app_secret_here

# OpenRouter AI Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Recommended free/low-cost models: google/gemini-2.5-flash, google/gemma-4-31b-it:free, openrouter/free
OPENROUTER_MODEL=google/gemini-2.5-flash

# Database Configuration
DATABASE_PATH=./data/goldkraft_leads.db
