<%- include('partials/header', { title: 'Staff' }) %>
<div class="mb-4"><p class="text-sm text-base-content/60">Owner only</p><h1 class="page-title max-lg:hidden">Staff accounts</h1></div>
<div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_24rem]">
  <ul class="space-y-2">
    <% for (const u of list) { %>
    <li class="rounded-box bg-base-100">
      <details class="collapse collapse-arrow">
        <summary class="collapse-title flex items-center gap-3 pr-10">
          <div class="avatar avatar-placeholder"><div class="w-10 rounded-full bg-neutral text-neutral-content"><span class="text-sm"><%= u.name.split(' ').map(s => s[0]).join('').slice(0, 2).toUpperCase() %></span></div></div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-1.5"><span class="font-semibold"><%= u.name %></span><span class="badge badge-ghost badge-xs"><%= ROLE_LABELS[u.role] %></span><% if (!u.active) { %><span class="badge badge-error badge-soft badge-xs">Disabled</span><% } %></div>
            <div class="truncate text-xs text-base-content/60"><%= u.email %> · <%= u.lead_count %> leads · <%= u.last_login_at ? 'seen ' + util.timeAgo(u.last_login_at) : 'never logged in' %><%= u.must_change_password ? ' · temp password' : '' %></div>
          </div>
        </summary>
        <div class="collapse-content space-y-4">
          <form method="post" action="/users/<%= u.id %>" class="grid gap-2 sm:grid-cols-2">
            <%- include('partials/csrf') %>
            <fieldset class="fieldset py-0"><legend class="fieldset-legend">Name</legend><input name="name" value="<%= u.name %>" required class="input w-full"></fieldset>
            <fieldset class="fieldset py-0"><legend class="fieldset-legend">Email</legend><input name="email" type="email" value="<%= u.email %>" required class="input w-full"></fieldset>
            <fieldset class="fieldset py-0"><legend class="fieldset-legend">Role</legend><select name="role" class="select w-full"><% for (const r of ROLES) { %><option value="<%= r %>" <%= r === u.role ? 'selected' : '' %>><%= ROLE_LABELS[r] %></option><% } %></select></fieldset>
            <fieldset class="fieldset py-0"><legend class="fieldset-legend">Manager (sales)</legend><select name="manager_id" class="select w-full"><option value="">None</option><% for (const m of managers) { %><option value="<%= m.id %>" <%= m.id === u.manager_id ? 'selected' : '' %>><%= m.name %></option><% } %></select></fieldset>
            <label class="label tap cursor-pointer gap-2"><input type="checkbox" name="active" value="1" class="toggle toggle-primary toggle-sm" <%= u.active ? 'checked' : '' %>> Active</label>
            <button class="btn btn-primary sm:justify-self-end" type="submit">Save</button>
          </form>
          <form method="post" action="/users/<%= u.id %>/password" class="flex items-end gap-2 border-t border-base-300 pt-3">
            <%- include('partials/csrf') %>
            <fieldset class="fieldset flex-1 py-0"><legend class="fieldset-legend">Set temporary password</legend><input name="password" type="password" autocomplete="new-password" minlength="10" required class="input w-full"></fieldset>
            <button class="btn" type="submit">Reset</button>
          </form>
        </div>
      </details>
    </li>
    <% } %>
  </ul>

  <section class="h-fit rounded-box bg-base-100 p-4">
    <h2 class="mb-3">Add staff member</h2>
    <form method="post" action="/users" class="space-y-2">
      <%- include('partials/csrf') %>
      <fieldset class="fieldset py-0"><legend class="fieldset-legend">Name</legend><input id="n" name="name" required value="<%= form.name || '' %>" class="input w-full"></fieldset>
      <fieldset class="fieldset py-0"><legend class="fieldset-legend">Email</legend><input id="e" name="email" type="email" required value="<%= form.email || '' %>" class="input w-full"></fieldset>
      <div class="grid grid-cols-2 gap-2">
        <fieldset class="fieldset py-0"><legend class="fieldset-legend">Role</legend><select id="r" name="role" class="select w-full"><% for (const r of ROLES) { %><option value="<%= r %>" <%= (form.role || 'sales') === r ? 'selected' : '' %>><%= ROLE_LABELS[r] %></option><% } %></select></fieldset>
        <fieldset class="fieldset py-0"><legend class="fieldset-legend">Manager</legend><select id="m" name="manager_id" class="select w-full"><option value="">None</option><% for (const m of managers) { %><option value="<%= m.id %>"><%= m.name %></option><% } %></select></fieldset>
      </div>
      <fieldset class="fieldset py-0"><legend class="fieldset-legend">Temporary password</legend><input id="p" name="password" type="password" autocomplete="new-password" minlength="10" required class="input w-full"><p class="label">They'll be asked to change it at first login.</p></fieldset>
      <button class="btn btn-primary w-full" type="submit">Create account</button>
    </form>
  </section>
</div>
<%- include('partials/footer') %>
