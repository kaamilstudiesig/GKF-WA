<%# R8: "Finish setup" on the owner's dashboard, until every required step is done. left = setup status. %>
<% if (left) { const next = left.steps.find(x => x.key === left.next); %>
<a href="/setup" class="mb-4 flex items-center gap-3 rounded-box bg-base-100 p-4 transition hover:bg-base-300">
  <div class="min-w-0 flex-1">
    <div class="font-semibold">Finish setup</div>
    <div class="text-sm text-base-content/60"><%= left.done %> of <%= left.total %> done<%= next ? ' · next: ' + next.title : '' %></div>
    <progress class="progress progress-primary mt-2 w-full" value="<%= left.done %>" max="<%= left.total %>" aria-label="Setup steps done"></progress>
  </div>
  <span class="btn btn-primary btn-sm">Continue</span>
</a>
<% } %>
