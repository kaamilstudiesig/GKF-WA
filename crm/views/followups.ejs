<%- include('partials/header', { title: 'Follow-ups' }) %>
<% const nowIso = new Date().toISOString(); %>
<div class="mb-4">
  <p class="text-sm text-base-content/60"><%= items.length %> <%= status %></p>
  <h1 class="page-title max-lg:hidden">Follow-ups</h1>
</div>
<div class="mb-4 flex flex-wrap gap-2">
  <div role="tablist" class="tabs tabs-box">
    <a role="tab" href="/followups?view=<%= view %>&status=open" class="tab <%= status === 'open' ? 'tab-active' : '' %>">Open</a>
    <a role="tab" href="/followups?view=<%= view %>&status=done" class="tab <%= status === 'done' ? 'tab-active' : '' %>">Done</a>
  </div>
  <% if (can.viewTeamFollowUps(user)) { %>
  <div role="tablist" class="tabs tabs-box">
    <a role="tab" href="/followups?view=mine&status=<%= status %>" class="tab <%= view === 'mine' ? 'tab-active' : '' %>">Mine</a>
    <a role="tab" href="/followups?view=team&status=<%= status %>" class="tab <%= view === 'team' ? 'tab-active' : '' %>"><%= user.role === 'owner' ? 'Everyone' : 'My team' %></a>
  </div>
  <% } %>
</div>
<% if (!items.length) { %><p class="rounded-box bg-base-100 py-10 text-center text-sm text-base-content/60">Nothing here.</p><% } else { %>
<ul class="list rounded-box bg-base-100">
  <% for (const f of items) { const late = status === 'open' && f.due_at < nowIso; const today = status === 'open' && !late && f.due_at.slice(0, 10) === nowIso.slice(0, 10); %>
  <li class="list-row items-center">
    <span class="status <%= status === 'done' ? 'status-neutral' : late ? 'status-error' : today ? 'status-warning' : 'status-success' %>"></span>
    <div class="min-w-0">
      <div class="truncate font-medium"><%= f.title %></div>
      <div class="mt-0.5 flex flex-wrap items-center gap-1.5 text-xs text-base-content/60">
        <a class="link link-hover text-base-content/80" href="/leads/<%= f.wa_id %>"><%= util.leadTitle(f) %></a>
        <% if (f.lead_status) { %><%- include('partials/status', { status: f.lead_status }) %><% } %>
        <span>· <%= f.user_name %></span>
        <span class="<%= late ? 'text-error font-medium' : today ? 'text-warning' : '' %>">· <%= util.fmtDate(status === 'open' ? f.due_at : f.completed_at) %><% if (late) { %> · overdue<% } %></span>
      </div>
    </div>
    <% if (status === 'open') { %><form method="post" action="/followups/<%= f.id %>/done"><%- include('partials/csrf') %><button class="btn btn-sm">Done</button></form><% } %>
  </li>
  <% } %>
</ul><% } %>
<%- include('partials/footer') %>
