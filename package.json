{
  "name": "goldkraft-whatsapp-ai-backend",
  "version": "1.0.0",
  "description": "WhatsApp AI Lead-Management Backend for Goldkraft Fitness via Meta Cloud API and OpenRouter",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "NODE_ENV=test node --test test/**/*.test.js",
    "backup": "node scripts/backup_database.js",
    "migrate": "node -e \"require('./src/db/database').getDatabase(); console.log('Migrations complete.');\""
  },
  "keywords": [
    "whatsapp",
    "meta-cloud-api",
    "openrouter",
    "ai-agent",
    "crm",
    "lead-management"
  ],
  "author": "Goldkraft Fitness Dev Team",
  "license": "ISC",
  "dependencies": {
    "@azure/storage-blob": "^12.33.0",
    "@sentry/node": "^10.73.0",
    "axios": "^1.7.9",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
