<%- include('partials/header', { title: 'Change password' }) %>
<div class="mb-4"><p class="text-sm text-base-content/60">Account</p><h1 class="page-title max-lg:hidden">Change password</h1></div>
<section class="max-w-md rounded-box bg-base-100 p-4">
  <% if (first) { %><div role="alert" class="alert alert-warning alert-soft mb-4 text-sm">You're using a temporary password. Set your own before continuing.</div><% } %>
  <form method="post" action="/account/password" class="space-y-2">
    <%- include('partials/csrf') %>
    <fieldset class="fieldset py-0"><legend class="fieldset-legend">Current password</legend><input id="cur" name="current_password" type="password" autocomplete="current-password" required class="input w-full"></fieldset>
    <fieldset class="fieldset py-0"><legend class="fieldset-legend">New password</legend><input id="new" name="new_password" type="password" autocomplete="new-password" minlength="10" required class="input w-full"><p class="label">At least 10 characters, with letters and numbers.</p></fieldset>
    <fieldset class="fieldset py-0"><legend class="fieldset-legend">Confirm new password</legend><input id="conf" name="confirm_password" type="password" autocomplete="new-password" minlength="10" required class="input w-full"></fieldset>
    <button class="btn btn-primary w-full" type="submit">Update password</button>
  </form>
</section>
<%- include('partials/footer') %>
