# --- Server ---
PORT=4000
NODE_ENV=development
# Hours a login stays valid
SESSION_TTL_HOURS=12

# --- Database ---
# The WhatsApp bot's Postgres database (Heroku sets DATABASE_URL). The CRM reads
# the bot's leads/messages/handoffs/ai_usage tables, queues staff replies in its
# outbound_messages table, and keeps its own data in crm_* tables.
# SSL is used unless the host is localhost (or DATABASE_SSL=false).
# DATABASE_URL=postgres://user:password@host:5432/dbname
#
# Local development without the bot: PGlite stored in ./data/pglite (the default
# when DATABASE_URL is unset). A demo copy of the bot's tables and the seed users
# are created on first start. Tests use pglite://memory.
# DATABASE_URL=pglite://./data/pglite
#
# Max connections in this process's pool (Heroku Essential-0 allows 20 in total)
# DATABASE_POOL_MAX=5

# Rough exchange rate for showing AI cost in rupees on the owner report
USD_TO_INR=85

# Timezone for displaying dates
DISPLAY_TIMEZONE=Asia/Kolkata

# Seed file with the starting staff accounts (see seed/users.example.json)
SEED_USERS_FILE=./seed/users.example.json
