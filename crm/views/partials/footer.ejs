    </main>
    <%
      const isActive = href => (href === '/' ? path === '/' : path.startsWith(href));
      const dockItems = [['/', 'Home', 'home'], ['/leads', 'Leads', 'users'], ['/followups', 'Follow-ups', 'calendar'], ['/pipeline', 'Pipeline', 'kanban']];
    %>
    <% if (!(typeof hideDock !== 'undefined' && hideDock)) { %>
    <nav class="dock dock-md z-30 border-t border-base-300 bg-base-100 lg:hidden" aria-label="Main">
      <% for (const [href, label, icon] of dockItems) { %>
        <a href="<%= href %>" class="<%= isActive(href) ? 'dock-active text-primary' : 'text-base-content/70' %>" <%= isActive(href) ? 'aria-current=page' : '' %>>
          <%- include('icon', { name: icon }) %><span class="dock-label"><%= label %></span>
        </a>
      <% } %>
      <label for="nav-drawer" class="text-base-content/70 cursor-pointer"><%- include('icon', { name: 'more' }) %><span class="dock-label">More</span></label>
    </nav>
    <% } %>
  </div>

  <div class="drawer-side z-40">
    <label for="nav-drawer" aria-label="Close menu" class="drawer-overlay"></label>
    <aside class="flex min-h-full w-72 flex-col gap-6 border-r border-base-300 bg-base-100 p-4">
      <div class="px-2 pt-2"><%- include('brand') %></div>
      <%
        const nav = [['/', 'Dashboard', 'home'], ['/leads', 'Leads', 'users'], ['/followups', 'Follow-ups', 'calendar'], ['/pipeline', 'Pipeline', 'kanban']];
        if (can.viewReports(user)) nav.push(['/reports', 'Reports', 'chart']);
        if (can.manageUsers(user)) nav.push(['/users', 'Staff', 'user']);
        if (can.manageBusiness && can.manageBusiness(user)) nav.push(['/settings', 'Business', 'clipboard']);
      %>
      <ul class="menu w-full gap-1 p-0 text-[15px]">
        <% for (const [href, label, icon] of nav) { %>
          <li><a href="<%= href %>" class="tap <%= isActive(href) ? 'menu-active' : '' %>"><%- include('icon', { name: icon }) %><%= label %></a></li>
        <% } %>
      </ul>
      <div class="mt-auto rounded-box bg-base-200 p-3">
        <div class="flex items-center gap-3">
          <div class="avatar avatar-placeholder"><div class="w-10 rounded-full bg-neutral text-neutral-content"><span><%= (user.name || '?').split(' ').map(s => s[0]).join('').slice(0, 2).toUpperCase() %></span></div></div>
          <div class="min-w-0"><div class="truncate font-semibold"><%= user.name %></div><div class="text-xs text-base-content/60"><%= ROLE_LABELS[user.role] %></div></div>
        </div>
        <div class="mt-3 flex gap-2">
          <a href="/account/password" class="btn btn-ghost btn-sm flex-1"><%- include('icon', { name: 'lock', cls: 'size-4' }) %>Password</a>
          <form method="post" action="/logout" class="flex-1">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-ghost btn-sm w-full" type="submit"><%- include('icon', { name: 'logout', cls: 'size-4' }) %>Log out</button>
          </form>
        </div>
      </div>
    </aside>
  </div>
</div>
</body>
</html>
